{
  "name": "voidtools",
  "version": "1.0.0",
  "description": "Offline developer and Minecraft utilities for Windows",
  "author": "VOIDTOOLS",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "package:site": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-download-site.ps1",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test",
    "windows:exe": "npm run build && electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.voidtools.desktop",
    "productName": "VOIDTOOLS",
    "asar": true,
    "directories": {
      "output": "outputs/windows-build"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "out",
        "to": "web"
      }
    ],
    "win": {
      "signExecutable": false,
      "target": [
        "portable"
      ],
      "artifactName": "VOIDTOOLS-Windows-${version}.${ext}"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.468.0",
    "next": "^15.5.28",
    "qrcode": "^1.5.4",
    "react": "^19.1.10",
    "react-dom": "^19.1.10"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
